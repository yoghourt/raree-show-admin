# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs retention: only adr / specs / spikes / supabase are tracked
/docs/authorization/
/docs/deployment/
/docs/findings/
/docs/implementation/
/docs/reviews/

.cursorrules
.cursor

# governance (root submodule working tree only; do not use bare `governance/` — it ignores scripts/governance/)
/governance/

# Image Runtime Spike local artifacts (SPIKE-IMG-001)
/spike-output/

# Image generation architecture spike outputs (PNGs + per-run meta)
/scripts/image-generation-spike/results/

# Discovery Visual Intent spike outputs
/scripts/discovery-visual-intent-spike/results/

# Renderer boundary spike outputs
/scripts/renderer-boundary-spike/results/

# Capability adaptation spike outputs
/scripts/capability-adaptation-spike/results/

# Visual consistency spike outputs
/scripts/visual-consistency-spike/results/

# Discovery expression ownership spike outputs
/scripts/discovery-expression-ownership-spike/results/

# Discovery contract spike outputs
/scripts/discovery-contract-spike/results/

# Python virtualenvs (local image spike / Diffusers)
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
